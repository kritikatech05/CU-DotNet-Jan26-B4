
@model List<Pulse.Models.Employee>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <h2>@ViewData["DepartmentName"] Dashboard</h2>

    <div class="alert alert-warning">
        @ViewBag.Announcement
    </div>


    @if ((bool)ViewData["ServerStatus"])
    {
        <div class="alert alert-success">
            Department Status: Active
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            Department Status: Under Maintenance
        </div>
    }

    <h3 class="mt-4">Employee List</h3>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Position</th>
                <th>Salary</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var emp in Model)
            {
                <tr>
                    <td>@emp.Id</td>
                    <td>@emp.Name</td>
                    <td>@emp.Position</td>
                    <td>@emp.Salary</td>
                </tr>
            }
        </tbody>

    </table>

</div>