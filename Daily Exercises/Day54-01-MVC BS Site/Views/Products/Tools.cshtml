@{
    ViewData["Title"] = "Tools";
}

<h2 class="text-center mb-4">Developer Tools</h2>

<div class="container">

    <table class="table table-hover">

        <thead class="table-dark">
            <tr>
                <th>Tool</th>
                <th>Version</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>

            <tr>
                <td>Code Analyzer</td>
                <td>1.2</td>
                <td><span class="badge bg-success">Stable</span></td>
            </tr>

            <tr>
                <td>Automation Tool</td>
                <td>2.0</td>
                <td><span class="badge bg-info">Updated</span></td>
            </tr>

            <tr>
                <td>Debug Assistant</td>
                <td>1.5</td>
                <td><span class="badge bg-warning">Testing</span></td>
            </tr>

        </tbody>

    </table>

</div>