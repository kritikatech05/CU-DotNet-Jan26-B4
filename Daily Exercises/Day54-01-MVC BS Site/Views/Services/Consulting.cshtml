@{
    ViewData["Title"] = "Consulting";
}

<h2 class="text-center mb-4">Consulting Services</h2>

<div class="container">

    <div class="accordion" id="consultingAccordion">

        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button" data-bs-toggle="collapse" data-bs-target="#service1">
                    IT Strategy Consulting
                </button>
            </h2>

            <div id="service1" class="accordion-collapse collapse show">
                <div class="accordion-body">
                    Helping companies plan and implement effective IT strategies.
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#service2">
                    Cloud Consulting
                </button>
            </h2>

            <div id="service2" class="accordion-collapse collapse">
                <div class="accordion-body">
                    Guidance on migrating and managing cloud infrastructure.
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#service3">
                    Security Consulting
                </button>
            </h2>

            <div id="service3" class="accordion-collapse collapse">
                <div class="accordion-body">
                    Improving security and protecting digital assets.
                </div>
            </div>
        </div>

    </div>

</div>

