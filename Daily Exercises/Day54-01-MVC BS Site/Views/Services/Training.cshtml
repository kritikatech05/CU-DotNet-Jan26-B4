@{
    ViewData["Title"] = "Training";
}

<h2 class="text-center mb-4">Training Programs</h2>

<div class="container">

    <div class="d-flex justify-content-center gap-4">

        <div class="card" style="width: 18rem;">
            <img src="~/img/sub-Asp-dotnet-training.png" class="card-img-top" style="height:200px; object-fit:cover;" alt="training">>
            <div class="card-body">
                <h5 class="card-title">ASP.NET Training</h5>
                <p class="card-text">
                    Learn modern web development using ASP.NET Core.
                </p>
                <a href="#" class="btn btn-primary">Learn More</a>
            </div>
        </div>

        <div class="card" style="width: 18rem;">
            <img src="~/img/cloud.jpg" class="card-img-top" style="height:200px; object-fit:cover;" alt="training">
            <div class="card-body">
                <h5 class="card-title">Cloud Training</h5>
                <p class="card-text">
                    Hands-on training for AWS and Azure cloud platforms.
                </p>
                <a href="#" class="btn btn-primary">Learn More</a>
            </div>
        </div>

    </div>

</div>
