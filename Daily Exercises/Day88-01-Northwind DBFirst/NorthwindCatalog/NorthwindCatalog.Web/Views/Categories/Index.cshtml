@model List<NorthwindCatalog.Services.DTOs.CategoryDto>

@{
    ViewData["Title"] = "Categories";
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="fw-bold display-6">Northwind Categories</h1>
        <p class="text-muted">Browse product categories and explore items available in each section.</p>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card category-card h-100 border-0 shadow-sm">
                    <img src="@item.ImageUrl" class="card-img-top category-img" alt="@item.CategoryName" />
                    <div class="card-body d-flex flex-column text-center">
                        <h5 class="card-title fw-semibold">@item.CategoryName</h5>
                        <p class="text-muted small mb-4">Click below to view products in this category.</p>
                        <a href="/Products/ByCategory/@item.CategoryId" class="btn btn-primary rounded-pill px-4 mt-auto">
                            View Products
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>