@model IEnumerable<FinTrack_Pro.Models.Transaction>

<h2>All Transactions</h2>

<table class="table table-bordered">

    <tr>
        <th>Date</th>
        <th>Description</th>
        <th>Category</th>
        <th>Amount</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Date</td>
            <td>@item.Description</td>
            <td>@item.Category</td>
            <td>@item.Amount</td>
        </tr>
    }

</table>