@model IEnumerable<FinTrack_Pro.Models.Account>

<h2>Accounts</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Create Account</a>

@foreach (var account in Model)
{

    <div class="card mb-2">

        <div class="card-header"
             data-bs-toggle="collapse"
             data-bs-target="#acc@account.Id"
             style="cursor:pointer">

            <strong>@account.AccountHolder</strong>
            &nbsp;&nbsp; | &nbsp;&nbsp;
            Balance: ₹@account.Balance

        </div>

        <div id="acc@account.Id" class="collapse">

            <div class="card-body">

                <table class="table">

                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Amount</th>
                    </tr>

                    @foreach (var t in account.Transactions)
                    {
                        <tr>
                            <td>@t.Date.ToShortDateString()</td>
                            <td>@t.Description</td>
                            <td>@t.Category</td>
                            <td>@t.Amount</td>
                        </tr>
                    }

                </table>

                <a asp-controller="Transaction"
                   asp-action="Create"
                   asp-route-accountId="@account.Id"
                   class="btn btn-success">
                    Add Transaction
                </a>

            </div>

        </div>

    </div>

}