@model FinTrack_Pro.Models.Account

@{
    ViewData["Title"] = "Create";
}

<h2>Create Account</h2>

<form asp-action="Create">

<div asp-validation-summary="All"></div>

<div class="form-group">
<label asp-for="AccountNumber"></label>
<input asp-for="AccountNumber" class="form-control"/>
</div>

<div class="form-group">
<label asp-for="AccountHolder"></label>
<input asp-for="AccountHolder" class="form-control"/>
</div>

<div class="form-group">
<label asp-for="Balance"></label>
<input asp-for="Balance" class="form-control"/>
</div>

<br>

<button class="btn btn-success">Create</button>

</form>
